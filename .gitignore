# R session files
.Rhistory
.RData
.Rproj.user/

# OS
.DS_Store

# DuckDB results databases are a local working store: large, binary, and they grow on every
# rewrite. What is committed is the compact snapshot next to each one
# (output/*/v*/db/snapshot/: Parquet tables + xz payload); read_*_db() rebuilds the .duckdb
# from it automatically on a fresh clone (pk-project scripts/db_snapshot.R).
*.duckdb
*.duckdb.wal

# nlmixr2 bootstrap caches (bootstrapFit() writes these into the working directory)
nlmixr2BootstrapCache_*/

# Quarto render caches (reports in output/*/v*/MAR/)
.quarto/
